@page "/products"
@using EasyBuy.Model
@inject HttpClient http
@rendermode InteractiveServer
<h3>ProductList</h3>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 row-cols-xxl-5 g-3">
    @foreach (var product in products)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">Price: @product.Price</p>
                    <p class="card-text">Quantity: @product.Quantity</p>
                    <a href="/cart/@product.Id" class="btn btn-primary">Buy</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ProductModel> products = new List<ProductModel>();

    protected override async Task OnInitializedAsync()
    {
        products = await http.GetFromJsonAsync<List<ProductModel>>("http://localhost:5088/api/product") ?? new List<ProductModel>();
        await base.OnInitializedAsync();
    }

}
